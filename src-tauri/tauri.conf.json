{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backup180",
  "version": "0.1.0",
  "identifier": "com.darts180.backup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Backup180",
        "width": 1000,
        "height": 700,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 darts180",
    "category": "Utility",
    "shortDescription": "File and folder backup utility with scheduling",
    "longDescription": "Backup180 — desktop backup utility built with Tauri. Select files and folders, set include/exclude masks, configure cron schedules per task, choose output destination, and run backups manually or on a schedule. Runs from system tray with auto-start support."
  }
}
